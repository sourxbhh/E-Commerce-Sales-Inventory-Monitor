# Copy to .env and fill in. Never commit .env.

# --- Azure ---
# Created by `infra/terraform/` on `terraform apply`.
# For local dev you can use the storage account key; in CI prefer a service principal.
AZURE_STORAGE_ACCOUNT=olistdlCHANGEME
AZURE_STORAGE_CONTAINER=raw
AZURE_STORAGE_KEY=                          # account key (local dev)
# --- OR --- service principal (preferred for CI / production)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=olist-rg
AZURE_LOCATION=eastus

# ADLS Gen2 abfss URI built from the above: abfss://{container}@{account}.dfs.core.windows.net/
ADLS_RAW_URI=abfss://raw@olistdlCHANGEME.dfs.core.windows.net/

# --- Kaggle (optional — only if re-downloading the dataset via API) ---
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_ORDERS=olist.orders
KAFKA_TOPIC_ORDER_ITEMS=olist.order_items
KAFKA_TOPIC_PAYMENTS=olist.payments

# --- Warehouse ---
DUCKDB_PATH=./warehouse/olist.duckdb
WAREHOUSE_SCHEMA_RAW=raw
WAREHOUSE_SCHEMA_STAGING=staging
WAREHOUSE_SCHEMA_MARTS=marts

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
